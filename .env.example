# Required for every authenticated Atlas tool and automatic hydration.
ATLAS_API_KEY=replace-with-an-atlas-api-key

# Optional runtime settings.
ATLAS_BASE_URL=https://api.bsyncs.com
ATLAS_CONTEXT_PERSONA=codex
# Optional global working-memory lane. When unset, a stable ID is derived from the project root.
# Set the same value in multiple workspaces/machines to share recent Atlas working memory.
# ATLAS_CONTEXT_SESSION_ID=atlas-plugin-development
ATLAS_CONTEXT_DEFAULT_MODE=full
ATLAS_CONTEXT_MAX_CHARS=8000
ATLAS_CONTEXT_TIMEOUT_MS=6000

# Automatic writeback is opt-in. Leave this off unless every new session should start enabled.
ATLAS_CONTEXT_WRITEBACK_DEFAULT=off
ATLAS_CONTEXT_WRITEBACK_MAX_CHARS=1200

# Optional case-insensitive regex. A malformed expression fails closed.
# ATLAS_SUBAGENT_MATCHER=explore|review|implement
